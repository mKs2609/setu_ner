# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# env
.env
.env.local
.env.*.local

# database exports for deployment (scripts/deploy/export_data.ps1)
data/deploy/
*.dump

# ml artifacts
ml/models/*.pkl
ml/models/*.joblib
!ml/models/README.md

# os / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# logs
*.log

# generated geo outputs -- regenerate via the scripts, don't commit
geo/**/*.geojson
geo/**/*.graphml
geo/**/cache/
geo/**/*.json
geo/**/*.png
# ...except the gazetteer, which planning reads at runtime and is small,
# reviewable and not cheaply regenerable (docs/decisions/0011).
!geo/gazetteer/
!geo/gazetteer/corridor_places.json
# ...and the district rainfall boxes, read at runtime by the model for the
# same reason (built by geo/rainfall/fetch_district_points.py).
!geo/rainfall/
!geo/rainfall/assam_district_points.json
apps/web/next-env.d.ts
# Build/tooling caches
.turbo/
*.tsbuildinfo

# The handbook is a personal reference, kept local: the PDF is a binary and
# the source is a long document nobody reviews in a pull request.
docs/*.pdf
docs/handbook/
.claude/
