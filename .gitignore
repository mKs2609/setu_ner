# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# env
.env
.env.local
.env.*.local

# data (never commit real datasets)
data/raw/*
data/processed/*
# database exports for deployment (scripts/deploy/export_data.ps1)
data/deploy/
*.dump
!data/raw/README.md
!data/processed/README.md

# ml artifacts
ml/models/*.pkl
ml/models/*.joblib
!ml/models/README.md

# os / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# logs
*.log

# generated geo outputs -- regenerate via the scripts, don't commit
geo/**/*.geojson
geo/**/*.graphml
geo/**/cache/
geo/**/*.json
geo/**/*.png
# ...except the gazetteer, which planning reads at runtime and is small,
# reviewable and not cheaply regenerable (docs/decisions/0011).
!geo/gazetteer/
!geo/gazetteer/corridor_places.json
apps/web/next-env.d.ts
# Build/tooling caches
.turbo/
*.tsbuildinfo

# Generated handbook -- rebuild from the script rather than committing a binary
docs/*.pdf
