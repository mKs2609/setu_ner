# Local development defaults. In production every value below that says
# "production" must be set -- the API refuses to start otherwise
# (app/config.py, production_problems).

ENVIRONMENT=development

# production: the hosted Postgres URL, with ?sslmode=require
DATABASE_URL=postgresql://sih26002:sih26002@localhost:5432/sih26002

# production: the deployed web origin(s), no trailing slash. One value,
# several comma-separated, or a JSON list -- all accepted.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# production: SHA-256 hashes of operator tokens. Never the tokens themselves.
# One value, comma-separated, or JSON.
#   python -m app.security new-token
# Empty in development means writes are open.
OPERATOR_TOKEN_HASHES=[]

# true only if field reports should be accepted from anyone without a token.
# They close and slow roads in routing, so the production default is false.
PUBLIC_FIELD_REPORTS=false

# Concurrent supply plans before new ones get 429 (memory bound).
MAX_CONCURRENT_PLANS=2

# Filled in once scripts/data-access-checks/ confirms real access shape
CWC_NWDP_BASE_URL=
ASDMA_BASE_URL=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
